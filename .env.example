# ---- Required ----
# Railway Postgres: reference it as ${{Postgres.DATABASE_URL}} in the service variables.
DATABASE_URL=postgres://postgres:password@localhost:5432/airdvance
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts ID and bank account numbers at rest. Never change it once data exists.
DATA_ENCRYPTION_KEY=
APP_URL=https://airdvance.co.za

# ---- Legal entity (confirm with your NCR registration) ----
COMPANY_LEGAL_NAME=Sequence Industries
COMPANY_NCRCP=NCRCP21330
COMPANY_REG_NUMBER=
COMPANY_ADDRESS=
COMPANY_EMAIL=hello@airdvance.co.za
COMPANY_COMPLAINTS_EMAIL=complaints@airdvance.co.za
COMPANY_PRIVACY_EMAIL=privacy@airdvance.co.za
COMPANY_INFORMATION_OFFICER=
COMPANY_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Bank account customers pay into for early settlement (shown on the dashboard)
COLLECTION_BANK=
COLLECTION_ACCOUNT_NAME=
COLLECTION_ACCOUNT_NUMBER=
COLLECTION_BRANCH_CODE=

# ---- SMS / WhatsApp PINs (without these, PINs show on screen in demo mode) ----
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Pricing overrides (always clamped to NCA caps) ----
# RATE_FIRST_LOAN_MONTHLY=0.05
# RATE_REPEAT_LOAN_MONTHLY=0.03
# INITIATION_FEE_BASE=165
# MONTHLY_SERVICE_FEE=60

# HIDE_DEMO_BANNER=true   # only once real payments and messaging are live
